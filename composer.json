{
    "name": "ianfoxdev/decline-codes",
    "description": "Payment decline codes normalized across card networks and PSPs, and a retry policy that follows the networks' reattempt rules, with a source for every rule.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "payments",
        "decline-codes",
        "retry",
        "dunning",
        "visa",
        "mastercard",
        "stripe",
        "iso8583",
        "fintech"
    ],
    "homepage": "https://github.com/IanFoxDev/decline-codes",
    "authors": [
        {
            "name": "Anatoly Pankratyev",
            "email": "ianfoxdeveloper@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/IanFoxDev/decline-codes/issues",
        "source": "https://github.com/IanFoxDev/decline-codes"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "IanFoxDev\\DeclineCodes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IanFoxDev\\DeclineCodes\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
