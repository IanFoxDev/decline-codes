  "limits": [
    {
      "id": "consecutive_declines",
      "max_declines": 10,
      "window_hours": 24,
      "same": [
        "card",
        "acceptor"
      ],
      "effective_from": "2022-10-01",
      "sources": [
        "paya",
        "braintree"
      ],
      "note": "Stop after 10 consecutive declines on the same card at the same card acceptor within 24 hours; the threshold was 20 before 1 October 2022."
    },
    {
      "id": "declines_same_amount",
      "max_declines": 35,
      "window_days": 30,
      "same": [
        "card",
        "acceptor",
        "amount"
      ],
      "effective_from": "2024-04-01",
      "sources": [
        "braintree"
      ],
      "note": "Braintree describes this in its Canada network update; other processors describe it without a region, and one gives 1 August 2024. Applied everywhere from the earlier date, as the stricter reading."
    }
  ],
